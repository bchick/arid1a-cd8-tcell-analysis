/*
 * Nextflow configuration for McDonald et al. 2023 reanalysis
 * Tested on: 64 cores, 503 GB RAM, Docker (Singularity also works).
 * Adjust max_cpus / max_memory / executor below for your system.
 */

// Global parameters
params {
    // Repository root: set ARID1A_PROJECT_DIR, or launch Nextflow from the repo root
    project_dir  = System.getenv('ARID1A_PROJECT_DIR') ?: "${launchDir}"

    // Reference genome
    genome       = null  // Don't use iGenomes; we supply our own
    fasta        = "${params.project_dir}/data/reference/GRCm39.primary_assembly.genome.fa"
    gtf          = "${params.project_dir}/data/reference/gencode.vM35.primary_assembly.annotation.gtf"

    // Output
    outdir       = "${params.project_dir}/results"

    // General
    max_cpus     = 24
    max_memory   = '400.GB'  // Leave ~100 GB headroom
    max_time     = '72.h'
}

// Container engine
docker {
    enabled      = true
    runOptions   = '-u $(id -u):$(id -g)'
}

// Process resource defaults
process {
    // Default resources
    cpus   = { 4 * task.attempt }
    memory = { 8.GB * task.attempt }
    time   = { 4.h * task.attempt }

    // Retry on resource errors
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 143, 247] ? 'retry' : 'finish' }
    maxRetries    = 2

    // Specific process overrides
    withLabel: process_low {
        cpus   = { 2 * task.attempt }
        memory = { 4.GB * task.attempt }
    }
    withLabel: process_medium {
        cpus   = { 8 * task.attempt }
        memory = { 32.GB * task.attempt }
    }
    withLabel: process_high {
        cpus   = { 16 * task.attempt }
        memory = { 64.GB * task.attempt }
    }
    withLabel: process_high_memory {
        cpus   = { 16 * task.attempt }
        memory = { 128.GB * task.attempt }
    }
}

// Execution settings
executor {
    name      = 'local'
    cpus      = 24
    memory    = '400 GB'
}

// Work directory on /data (plenty of space)
workDir = "${System.getenv('ARID1A_PROJECT_DIR') ?: launchDir}/work"

// Timeline and reporting
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/dag.html"
    overwrite = true
}

// Profiles for different pipeline runs
profiles {
    atacseq {
        params {
            outdir = "${params.project_dir}/results/atac"
        }
    }
    rnaseq {
        params {
            outdir       = "${params.project_dir}/results/rnaseq"
            aligner      = 'star_salmon'
        }
    }
    cutandrun {
        params {
            outdir    = "${params.project_dir}/results/cutrun"
            peakcaller = 'macs2,seacr'
        }
    }
    chipseq {
        params {
            outdir = "${params.project_dir}/results/chipseq"
        }
    }
}
